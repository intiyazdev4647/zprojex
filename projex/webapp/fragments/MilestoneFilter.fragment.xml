<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<ViewSettingsDialog
		id="settingsDialog"
		confirm="handleConfirm"
		cancel="handleCancel"
		resetFilters="handleResetFilters">
		<filterItems>
			<ViewSettingsCustomItem
				id="idStatusItem"
				text="Status"
				key="myStatus">
				<customControl>
					<MultiComboBox 
						id="statusFilter" placeholder="Select Status"
						items="{path: 'projectsModel>/milestones'}"
						 >	
						 <items>
						 	<core:Item key="{projectsModel>Status}" text="{projectsModel>Status}"></core:Item>
						 </items>
						 </MultiComboBox>
						
				</customControl>
			</ViewSettingsCustomItem>
			<ViewSettingsCustomItem
				id="idOwnerItem"
				text="Owner"
				key="myOnwer">
				<customControl>
					<MultiComboBox 
						id="ownerFilter" placeholder="Select Owner"
						items="{path: 'projectsModel>/milestones'}"
						 >	
						 <items>
						 	<core:Item key="{projectsModel>Owner}" text="{projectsModel>Owner}"></core:Item>
						 </items>
						 </MultiComboBox>
				</customControl>
			</ViewSettingsCustomItem>
		</filterItems>
	</ViewSettingsDialog>
</core:FragmentDefinition>