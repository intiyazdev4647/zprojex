<mvc:View xmlns:form="sap.ui.layout.form" xmlns:rowmodes="sap.ui.table.rowmodes" controllerName="com.ennovi.projex.controller.CreateProject"
    xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page title="Create Milestone" showHeader="false" >
        <content>
           <Panel >
            <form:SimpleForm editable="true">
                <form:content>
                    <Label text="Project Name" required="true"></Label>
                    <Input  width="50%" value=""></Input>
                    <Label text="Project Owner" required="true"></Label>
                    <Input  width="50%" value=""></Input>
                    <Label text="Project Description" required="true"></Label>
                    <Input  width="50%" value=""></Input>
                    <Label text="Start Date" required="true"></Label>
                    <DatePicker  width="50%" value="" displayFormat="yyyy/MM/dd" valueFormat="yyyy-MM-dd" ></DatePicker>
                    <Label text="End Date"></Label>
                    <DatePicker  width="50%" value="" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" ></DatePicker>
                    <Label text="Department" required="true"></Label>
                    <Input  width="50%" value=""></Input>
                    <Label text="Site" required="true"></Label>
                    <Input  width="50%" value=""></Input>
                    <Label text="Email" ></Label>
                    <Input  width="50%" value=""></Input>
                    <Label text="Phone Number" ></Label>
                    <Input  width="50%" value=""></Input>
                    <Label text="Business Project Manager" ></Label>
                    <Input  width="50%" value=""></Input>

                </form:content>
            </form:SimpleForm>
           
           </Panel>
        </content>
        <footer>
            <Toolbar >
                <ToolbarSpacer />
                <Button text="Create" type="Emphasized" press="onCreateMilestone"/>
                <Button text="Cancel" press="onCancel"/>
            </Toolbar>
        </footer>
    </Page>
    
</mvc:View>