<mvc:View xmlns:form="sap.ui.layout.form" xmlns:rowmodes="sap.ui.table.rowmodes" controllerName="com.ennovi.projex.controller.CreateProject"
    xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page title="Create Project" showHeader="true" >
        <content>
           <Panel >
            <form:SimpleForm editable="true">
                <form:content>
                    <Label text="Project Id" required="true"></Label>
                    <Input id="inpProjId" change="projectIdChange" width="50%"></Input>
                    <Label text="Project Name" required="true"></Label>
                    <Input id="inpProjName" width="50%"></Input>
                    <Label text="Project Owner" required="true"></Label>
                    <Input id="inpProjOwner" width="50%"></Input>
                    <Label text="Project Description" required="true"></Label>
                    <Input id="inpProjDesc" width="50%"></Input>
                    <Label text="Start Date" required="true"></Label>
                    <DatePicker id="startD" width="50%" value="" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" ></DatePicker>
                    <Label text="End Date"></Label>
                    <DatePicker id="endD" width="50%" value="" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" ></DatePicker>
                    <Label text="Department" required="true"></Label>
                    <Input id="idDepartment" width="50%" ></Input>
                    <Label text="Site" required="true"></Label>
                    <Input id="idSite" width="50%" ></Input>
                    <Label text="Email" ></Label>
                    <Input id="idEmail" width="50%" ></Input>
                    <Label text="Country Code"></Label>
                    <ComboBox id="countryCodeCB" width="50%" selectedItem="+91">
                        <core:Item key="+91" text="+91 - India"/>
                        <core:Item key="+1" text="+1 - United States"/>
                        <core:Item key="+44" text="+44 - United Kingdom"/>
                    </ComboBox>
                    <Label text="Phone Number" ></Label>
                    <Input id="idPhone" width="50%" ></Input>
                    <Label text="Business Project Manager" ></Label>
                    <Input id="idBusinessPM" width="50%" ></Input>

                </form:content>
            </form:SimpleForm>
           
           </Panel>
        </content>
        <footer>
            <Toolbar >
                <ToolbarSpacer />
                <Button text="Create" type="Emphasized" press="onCreateProject"/>
                <Button text="Cancel" press="onCancel"/>
            </Toolbar>
        </footer>
    </Page>
    
</mvc:View>