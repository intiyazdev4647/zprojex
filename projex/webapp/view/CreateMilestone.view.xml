<mvc:View
    controllerName="com.ennovi.projex.controller.CreateMilestone"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <Page
        title="Create Milestone"
        showHeader="false">

        <content>

            <!-- Main Container -->
            <VBox class="sapUiMediumMargin">

                <!-- Top Form -->
                <form:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="3"
                    labelSpanS="12"
                    adjustLabelSpan="false"
                    emptySpanXL="4"
                    emptySpanL="4"
                    emptySpanM="4"
                    emptySpanS="0"
                    columnsXL="1"
                    columnsL="1"
                    columnsM="1"
                    singleContainerFullSize="false">

                    <form:content>

                        <Label
                            text="Project"
                            required="true" />

                        <ComboBox
                            id="idProjCB"
                            width="80%" 
                            items="{projectsModel>/Projects}"
                            change="onSelectProject">

                            <items>
                                <core:Item
                                    text="{projectsModel>}"
                                    key="{projectsModel>}" />
                            </items>

                        </ComboBox>

                        <Label
                            text="Milestone"
                            required="true" />

                        <Input
                            id="inpMilestone"
                            width="80%"
                            change="milestoneChange" />

                    </form:content>

                </form:SimpleForm>

                <!-- Milestone Information Panel -->
                <Panel
                    headerText="Milestone Information"
                    expandable="true"
                    expanded="true"
                    visible="{milestone>/visible}"
                    class="sapUiMediumMarginTop">

                    <form:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="3"
                        labelSpanL="3"
                        labelSpanM="3"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="4"
                        emptySpanL="4"
                        emptySpanM="4"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false">

                        <form:content>

                            <!-- Flag -->
                            <Label
                                text="Flag"
                                required="true" />

                            <ComboBox
                                id="flagCB"
                                width="80%"
                                change="onSelectFlag">

                                <items>
                                    <core:Item text="Internal" key="I" />
                                    <core:Item text="External" key="E" />
                                </items>

                            </ComboBox>

                            <!-- Owner -->
                            <Label
                                text="Owner"
                                required="true" />

                            <ComboBox
                                id="ownerCB"
                                width="80%" selectedKey="{userModel>/id}"
                                items="{dropdownModel>/Owners}" 
                                loadItems="loadOwnersData"
                                change="onSelectOwner">

                                <items>
                                    <core:Item 
                                        text="{dropdownModel>text}" 
                                        key="{dropdownModel>key}" />
                                </items>

                            </ComboBox>

                            <!-- Start Date -->
                            <Label
                                text="Start Date"
                                required="true" />

                            <DatePicker
                                id="sDate"
                                width="80%"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="dd/MM/yyyy" />

                            <!-- End Date -->
                            <Label text="End Date" />

                            <DatePicker
                                id="eDate"
                                width="80%"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="dd/MM/yyyy" />

                            <!-- Business Owner -->
                            <Label text="Business Owner" />

                            <ComboBox
                                id="businessOwnerCB"
                                width="80%"
                                items="{dropdownModel>/Owners}"
                                loadItems="loadOwnersData"
                                change="onSelectBOwner">

                                <items>
                                    <core:Item
                                        text="{dropdownModel>text}"
                                        key="{dropdownModel>key}" />
                                </items>

                            </ComboBox>

                        </form:content>

                    </form:SimpleForm>

                </Panel>

            </VBox>

        </content>

        <footer>

            <Toolbar>
                <ToolbarSpacer />

                <Button
                    text="Create"
                    type="Emphasized"
                    press="onCreateMilestone" />

                <Button
                    text="Cancel"
                    press="onCancel" />

            </Toolbar>

        </footer>

    </Page>

</mvc:View>