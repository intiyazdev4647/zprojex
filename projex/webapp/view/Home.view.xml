<mvc:View controllerName="com.ennovi.projex.controller.Home"
    xmlns:cards="sap.f.cards" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:layout="sap.ui.layout" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns:f="sap.f"
    displayBlock="true">
    
    <Page title="Home" showHeader="false" class="sapUiTinyMarginBegin sapUiTinyMarginTop" showNavButton="false" >
        <content>
            <!-- <Image src="./Images/ennovi_bg.jpg" width="100%"></Image> -->
            <VBox >
                <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiMediumMarginBottom sapUiSmallMarginTop">
                    <!-- My Projects Card -->
                    <f:Card>
                        <f:header>
                            <cards:Header title="My Projects" />
                        </f:header>

                        <f:content>
                            <ScrollContainer
                                height="14.5rem" width="100%"
                                vertical="true"
                                focusable="false">

                                    <List id="projectsList"
                                        items="{projectsModel>/projects}"
                                        mode="SingleSelectMaster"  itemPress=".onProjectPress"
                                         >

                                        <StandardListItem type="Navigation"
                                            title="{projectsModel>ProjectName}" description="{projectsModel>Description}"
                                            icon="sap-icon://activity-2" />

                                    </List>

                            </ScrollContainer>
                        </f:content>
                    </f:Card>
                    <!-- My MileStones -->
                    <f:Card>
                        <f:header>
                            <cards:Header title="My MileStones" />
                        </f:header>
                        <f:content>
                            <ScrollContainer
                                height="14.5rem" width="100%"
                                vertical="true"
                                focusable="false">

                                <List id="milestonesList"
                                    items="{projectsModel>/milestones}"
                                    itemPress="onMilestonePress"
                                    showSeparators="All">

                                    <StandardListItem type="Navigation"
                                        title="{projectsModel>Name}"
                                        description="{projectsModel>Project}"
                                        icon="sap-icon://goal" />
                                </List>

                            </ScrollContainer>
                        </f:content>
                    </f:Card>
                    <!-- My Tasks -->
                    <f:Card>
                        <f:header>
                            <cards:Header title="My Tasks" />
                        </f:header>
                        <f:content>
                            <ScrollContainer
                                height="14.5rem" width="100%"
                                vertical="true"
                                focusable="false">

                                <List id="tasksList"
                                    items="{projectsModel>/tasks}"
                                    mode="None"
                                    showSeparators="All">
                                <StandardListItem
                                    title="{projectsModel>TaskName}"
                                    description="{projectsModel>Description}"
                                    info="Priority - {projectsModel>Priority}"
                                    icon="sap-icon://task" press="onTaskPress" />
                                </List>

                            </ScrollContainer>
                        </f:content>
                    </f:Card>
                    <!-- My Overdue Work Items -->
                    <f:Card>
                        <f:header>
                            <cards:Header title="My Overdue Work Items" />
                        </f:header>
                        <f:content>
                            <ScrollContainer
                                height="14.5rem" width="100%"
                                vertical="true"
                                focusable="false">

                                <List
                                    items="{projectsModel>/overdueItems}"
                                    mode="None"
                                    showSeparators="All">

                                     <StandardListItem
                                            title="{projectsModel>title}"
                                            description="{projectsModel>project}"
                                            info="{projectsModel>daysOverdue} days overdue"
                                            icon="sap-icon://alert" press="onOverdueItemPress" />

                                </List>

                            </ScrollContainer>
                        </f:content>
                    </f:Card>
                </layout:Grid>
            </VBox>
        </content>
    </Page>
    
</mvc:View>