<mvc:View xmlns:core="sap.ui.core" 
    controllerName="com.ennovi.projex.controller.App"
    xmlns="sap.m" 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns:tnt="sap.tnt" 
    height="100%">

    <tnt:ToolPage id="app" sideExpanded="false" class="sapUiDemoToolPage">

        <tnt:header>
            <tnt:ToolHeader class="myToolHead">

                <Button 
                    id="sideNavigationToggleButton" 
                    icon="sap-icon://menu2" 
                    type="Transparent" 
                    press=".onSideNavButtonPress" 
                    tooltip="Collapse">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="NeverOverflow"/>
                    </layoutData>
                </Button>

                <Title text="Home" id="pageTitle" class="sapUiSmallMarginBegin" level="H2"/>

                <ToolbarSpacer/>

                <Title text="{i18n>appTitle}" level="H2"/>

                <ToolbarSpacer />

                <!-- <Avatar 
                    id="userAvatar"
                    displayShape="Circle"
                    displaySize="XS"
                    src="Images/msd.jpg" 
                    press=".onUserPress"/> -->

               <core:Icon  class="pointerCursor" src="sap-icon://customer" size="1.5rem" useIconTooltip="true"  press="onProfilePress" tooltip="Profile"></core:Icon>

            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation 
                class="myToolHead" 
                id="sideNav" 
                expanded="false" 
                selectedKey="{side>/selectedKey}" 
                itemSelect="onMenuSelect">

                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Home" icon="sap-icon://home" key="home"/>
                    <tnt:NavigationListItem text="Projects" icon="sap-icon://activity-2" key="projects"/>
                    <tnt:NavigationListItem text="Milestones" icon="sap-icon://goal" key="milestones"/>
                    <tnt:NavigationListItem text="Tasks" icon="sap-icon://task" key="tasks"/>
                    <tnt:NavigationListItem text="TimeLogs" icon="sap-icon://time-entry-request" key="timelogs"/>
                </tnt:NavigationList>

            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <App id="mainContents"/>
        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>