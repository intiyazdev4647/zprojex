<mvc:View xmlns:form="sap.ui.layout.form" xmlns:rowmodes="sap.ui.table.rowmodes" controllerName="com.ennovi.projex.controller.DisplayMilestone"
    xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page title="Edit Milestone" showNavButton="true" navButtonPress="onBack" showHeader="true" >
        <content>
           <Panel >
            <form:SimpleForm editable="true">
                <form:content>
                    <Label text="Project" required="true"></Label>
                    <Input width="50%" editable="false"  value="{projectModel>/Project}"/>
                    <!-- <ComboBox editable="false"  width="50%" items="{projectsModel>/Projects}" selectedKey="{projectModel>/Project}" change="onSelectProject">
                        <items>
                            <core:Item text="{projectsModel>}" key="{projectsModel>}"></core:Item>
                        </items>
                    </ComboBox> -->
                    <Label text="Milestone" required="true"></Label>
                    <Input editable="false"  width="50%" value="{projectModel>/Name}"></Input>
                    <Label text="Flag" required="true"></Label>
                    <!-- <ComboBox editable="false" change="onSelectFlag" selectedKey="{projectModel>/Flag}" width="50%">
                        <items>
                            <core:Item text="Internal" key="I"></core:Item>
                            <core:Item text="External" key="E"></core:Item>
                        </items>
                    </ComboBox> -->
                    <Input editable="false" width="50%" value="{= ${projectModel>/Flag}=== 'I' ? 'Internal' : ${projectModel>/Flag} === 'E' ? 'External' : ${projectModel>/Flag}}" />
                    <Label text="Owner" required="true"></Label>
                    <!-- <ComboBox  editable="false" items="{projectsModel>/Owners}" selectedKey="{projectModel>/Owner}" width="50%" change="onSelectOwner">
                        <items>
                            <core:Item text="{projectsModel>}" key="{projectsModel>}"></core:Item>
                        </items>
                    </ComboBox> -->
                    <Input editable="false" width="50%" value="{projectModel>/Owner}" />
                    <Label text="Start Date" required="true" ></Label>
                    <DatePicker editable="false" value="{path:'projectModel>/StartDate',type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                    pattern: 'dd-MM-yyyy'
                                } }" width="50%" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" ></DatePicker>
                    <Label text="End Date" ></Label>
                    <DatePicker editable="false" value="{path:'projectModel>/EndDate', type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                    pattern: 'dd-MM-yyyy'
                                } }" width="50%" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" ></DatePicker>
                    <Label text="Business Owner"></Label>
                    <!-- <ComboBox  editable="false" width="50%" items="{projectsModel>/BusProjMngrs}" selectedKey="{projectModel>/BusinessOwner}" change="onSelectBOwner"  >
                        <items>
                            <core:Item text="{projectsModel>}" key="{projectsModel>}"></core:Item>
                        </items>
                    </ComboBox> -->
                    <Input editable="false" width="50%" value="{projectModel>/BusinessOwner}" />
                </form:content>
            </form:SimpleForm>
           
           </Panel>
        </content>
        
    </Page>
    
</mvc:View>