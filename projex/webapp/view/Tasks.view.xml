<mvc:View controllerName="com.ennovi.projex.controller.Tasks"
    xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table" 
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    displayBlock="true">
    
    <Page title="Milestones" showHeader="false" class="sapUiTinyMarginTop">
        <content>
             <Panel >
            <t:Table
                id="tasksTable" enableColumnReordering="true"  rows="{projectsModel>/tasks}"
                fixedColumnCount="1" width="100%"  noData="No Records Found"
                selectionMode="Single" alternateRowColors="true" rowActionCount="10" 
                selectionBehavior="RowOnly" visibleRowCount="16" visibleRowCountMode="Fixed">
           
            <!-- HEADER TOOLBAR -->
            <t:extension>
                <OverflowToolbar>

                    <Title text="All Tasks"/>
                    <ToolbarSpacer/>

                    <!-- <SearchField
                        width="250px"
                        search=".onSearch"
                        placeholder="Search tasks..."
                        class="sapUiSmallMarginEnd"/> -->

                    <Button
                        text="Add Task"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press=".onAddTask"
                        class="sapUiTinyMarginEnd"/>

                    <Button
                        icon="sap-icon://filter"
                        press=".onFilterPress"
                        class="sapUiTinyMarginEnd"/>

                    <Button
                        text="Clear"
                        press=".onClear"/>

                </OverflowToolbar>
            </t:extension>

            <!-- ALL COLUMNS -->
            <t:columns>


                <!-- ID -->
                <t:Column width="100px">
                    <Label text="ID"/>
                    <t:template>
                        <Link text="{projectsModel>TaskID}" press="onTaskPress"/>
                    </t:template>
                </t:Column>
                <!-- Name -->
                <t:Column width="200px">
                    <Label text="Name"/>
                    <t:template>
                        <Text text="{projectsModel>TaskName}"/>
                    </t:template>
                </t:Column>

                <!-- Project -->
                <t:Column width="200px">
                    <Label text="Project" />
                    <t:template>
                        <Text text="{projectsModel>ProjectID}"/>
                    </t:template>
                </t:Column>

                 <!-- Owner -->
                <t:Column >
                    <Label text="Owner"/>
                    <t:template>
                        <Text text="{projectsModel>Owner}"/>
                    </t:template>
                </t:Column>

                <!-- Status -->
                <t:Column >
                    <Label text="Status"/>
                    <t:template>
                        <Text text="{projectsModel>Status}"/>
                    </t:template>
                </t:Column>

                <!-- Start Date -->
                <t:Column >
                    <Label text="Start Date"/>
                    <t:template>
                        <!-- <DatePicker
                            value="{startdate}"
                            displayFormat="dd-MM-yyyy"/> -->
                        <Text text="{ path: 'projectsModel>StartDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                    pattern: 'dd-MM-yyyy'
                                }
                            }"></Text>
                    </t:template>
                </t:Column>

                <!-- Due Date -->
                <t:Column >
                    <Label text="Due Date"/>
                    <t:template>
                        <!-- <DatePicker
                            value="{enddate}"
                            displayFormat="dd-MM-yyyy"/> -->
                         <Text text="{ path: 'projectsModel>DueDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                    pattern: 'dd-MM-yyyy'
                                }
                            }"></Text>
                    </t:template>
                </t:Column>

                <!-- Duration -->
                <t:Column >
                    <Label text="Duration"/>
                    <t:template>
                        <Text text="{projectsModel>Duration}"/>
                    </t:template>
                </t:Column>

                <!-- Complexity -->
                <t:Column >
                    <Label text="Complexity"/>
                    <t:template>
                        <Text text="{projectsModel>Complexity}"/>
                    </t:template>
                </t:Column>
                
                <!-- Created By -->
                <t:Column >
                    <Label text="Created By"/>
                    <t:template>
                        <Text text="{projectsModel>CreatedBy}"/>
                    </t:template>
                </t:Column>

                <!-- Timelog Total -->
                <t:Column >
                    <Label text="Timelog Total"/>
                    <t:template>
                        <Text text="{projectsModel>TimelogTotal}"/>
                    </t:template>
                </t:Column>

                <!-- Work Hours -->
                <t:Column >
                    <Label text="Work Hours"/>
                    <t:template>
                        <Link text="{projectsModel>WorkHours}"/>
                    </t:template>
                </t:Column>

            </t:columns>
        </t:Table>
        </Panel>
        </content>
    </Page>
    
</mvc:View>