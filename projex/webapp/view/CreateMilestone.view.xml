<mvc:View xmlns:form="sap.ui.layout.form" xmlns:rowmodes="sap.ui.table.rowmodes" controllerName="com.ennovi.projex.controller.CreateMilestone"
    xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page title="Create Milestone" showHeader="false" >
        <content>
           <Panel >
            <form:SimpleForm editable="true">
                <form:content>
                    <Label text="Project" required="true"></Label>
                    <!-- <Input id="inpProject"></Input> -->
                    <ComboBox id="idProjCB" width="50%" items="{projectsModel>/Projects}" change="onSelectProject">
                        <items>
                            <core:Item text="{projectsModel>}" key="{projectsModel>}"></core:Item>
                        </items>
                    </ComboBox>
                    <Label text="Milestone" required="true"></Label>
                    <Input id="inpMilestone" width="50%"></Input>
                    <Label text="Flag" required="true"></Label>
                    <ComboBox id="flagCB" change="onSelectFlag" width="50%">
                        <items>
                            <core:Item text="Internal" key="I"></core:Item>
                            <core:Item text="External" key="E"></core:Item>
                        </items>
                    </ComboBox>
                    <Label text="Owner" required="true"></Label>
                    <ComboBox id="ownerCB" items="{projectsModel>/Owners}" width="50%" change="onSelectOwner">
                        <items>
                            <core:Item text="{projectsModel>}" key="{projectsModel>}"></core:Item>
                        </items>
                    </ComboBox>
                    <Label text="Start Date" required="true"></Label>
                    <DatePicker id="sDate" value="" width="50%" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" ></DatePicker>
                    <Label text="End Date" ></Label>
                    <DatePicker id="eDate" value="" width="50%" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" ></DatePicker>
                    <Label text="Business Owner"></Label>
                    <ComboBox id="businessOwnerCB" width="50%" items="{projectsModel>/BusProjMngrs}" change="onSelectBOwner"  >
                        <items>
                            <core:Item text="{projectsModel>}" key="{projectsModel>}"></core:Item>
                        </items>
                    </ComboBox>
                </form:content>
            </form:SimpleForm>
           
           </Panel>
        </content>
        <footer>
            <Toolbar >
                <ToolbarSpacer />
                <Button text="Create" type="Emphasized" press="onCreateMilestone"/>
                <Button text="Cancel" press="onCancel"/>
            </Toolbar>
        </footer>
    </Page>
    
</mvc:View>