<mvc:View xmlns:form="sap.ui.layout.form" xmlns:rowmodes="sap.ui.table.rowmodes" controllerName="com.ennovi.projex.controller.EditProject"
    xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page title="Edit Project" showHeader="true" >
        <content>
           <Panel >
            <form:SimpleForm editable="true">
                <form:content>
                    <Label text="Project Name" required="true"></Label>
                    <Input  width="50%" value="{projectModel>/ProjectName}"></Input>
                    <Label text="Project Owner" required="true"></Label>
                    <Input  width="50%" value="{projectModel>/Owner}"></Input>
                    <Label text="Project Description" required="true"></Label>
                    <Input  width="50%" value="{projectModel>/Description}"></Input>
                    <Label text="Start Date" required="true"></Label>
                    <DatePicker  width="50%" value="{path:'projectModel>/StartDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                    pattern: 'dd-MM-yyyy'
                                }}" displayFormat="yyyy/MM/dd" valueFormat="yyyy-MM-dd" ></DatePicker>
                    <Label text="End Date"></Label>
                    <DatePicker  width="50%" value="{path:'projectModel>/EndDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                    pattern: 'dd-MM-yyyy'
                                }}" displayFormat="yyyy/MM/dd" valueFormat="yyyy-MM-dd" ></DatePicker>
                    <Label text="Department" required="true"></Label>
                    <Input  width="50%" value="{projectModel>/Department}"></Input>
                    <Label text="Site" required="true"></Label>
                    <Input  width="50%" value="{projectModel>/Site}"></Input>
                    <Label text="Email" ></Label>
                    <Input  width="50%" value="{projectModel>/Email}"></Input>
                    <Label text="Phone Number" ></Label>
                    <Input  width="50%" value="{projectModel>/CountryCode} {projectModel>/MobilePhone}"></Input>
                    <Label text="Business Project Manager" ></Label>
                    <Input  width="50%" value="{projectModel>/BusProjMngr}"></Input>

                </form:content>
            </form:SimpleForm>
           
           </Panel>
        </content>
        <footer>
            <Toolbar >
                <ToolbarSpacer />
                <Button text="Save" type="Emphasized" press="onSaveProject"/>
                <Button text="Cancel" press="onCancel"/>
            </Toolbar>
        </footer>
    </Page>
    
</mvc:View>