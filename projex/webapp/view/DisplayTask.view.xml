<mvc:View
    controllerName="com.ennovi.projex.controller.DisplayTask"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true"
    >

<Page title="Display Task" showNavButton="true" navButtonPress="onBack" navButtonTooltip="Back" showHeader="true">

    <content>

        <VBox>

            <!-- ================= Task Details ================= -->
            <Panel headerText="Task Details" expandable="true" expanded="true">
                <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                    <form:content>

                        <Label text="Project Name" required="true"/>
                        <Input editable="false" value="{displayTaskModel>/ProjectID}" width="50%"/>

                        <Label text="Task Name" required="true"/>
                        <Input editable="false" value="{displayTaskModel>/TaskName}" width="50%"/>

                        <Label text="Description" required="true"/>
                        <Input editable="false" value="{displayTaskModel>/Description}" width="50%"/>

                    </form:content>
                </form:SimpleForm>
            </Panel>


            <!-- ================= Task Info ================= -->
            <Panel headerText="Task Info" expandable="true" expanded="false">
                <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                    <form:content>

                        <Label text="Owner" required="true"/>
                        <Input editable="false" value="{displayTaskModel>/Owner}" width="50%"/>

                        <Label text="Current Owner" required="true"/>
                        <Input editable="false" value="{displayTaskModel>/CurrentOwner}" width="50%"/>

                        <Label text="CR Nature" required="true"/>
                        <Input editable="false" value="{displayTaskModel>/CRNature}" width="50%"/>

                        <Label text="Change Type" required="true"/>
                        <Input editable="false" value="{displayTaskModel>/ChangeType}" width="50%"/>

                        <Label text="SolMan CR Id"/>
                        <Input editable="false" value="{displayTaskModel>/SolmanCRID}" width="50%"/>

                        <Label text="Start Date"/>
                        <DatePicker editable="false" dateValue="{displayTaskModel>/StartDate}" width="50%"/>

                        <Label text="Due Date"/>
                        <DatePicker editable="false" dateValue="{displayTaskModel>/EndDate}" width="50%"/>

                        <Label text="HelpDesk Ticket Number"/>
                        <Input editable="false" value="{displayTaskModel>/HDTicketNo}" width="50%"/>

                        <Label text="Sprint"/>
                        <Input editable="false" value="{displayTaskModel>/Sprint}" width="50%"/>

                    </form:content>
                </form:SimpleForm>
            </Panel>


            <!-- ================= Functional Info ================= -->
            <Panel headerText="Functional Info" expandable="true" expanded="false">
                <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                    <form:content>

                        <Label text="Functional Owner"/>
                        <Input editable="false" value="{displayTaskModel>/FuncOwner}" width="50%"/>

                        <Label text="SAP CoE Group"/>
                        <Input editable="false" value="{displayTaskModel>/SAPCOEGrp}" width="50%"/>

                        <Label text="Priority"/>
                        <Input editable="false" value="{displayTaskModel>/Priority}" width="50%"/>

                        <Label text="Module"/>
                        <Input editable="false" value="{displayTaskModel>/CRModule}" width="50%"/>

                        <Label text="Impact" required="true"/>
                        <Input editable="false" value="{displayTaskModel>/Impact}" width="50%"/>

                        <Label text="Functional Spec URL"/>
                        <Input editable="false" value="{displayTaskModel>/FSDURL}" width="50%"/>

                        <Label text="Functional Test Script"/>
                        <Input editable="false" value="{displayTaskModel>/FTURL}" width="50%"/>

                        <Label text="Config Document"/>
                        <Input editable="false" value="{displayTaskModel>/ConfigDocURL}" width="50%"/>

                        <Label text="Additional Documents"/>
                        <Input editable="false" value="{displayTaskModel>/AddDocURL}" width="50%"/>

                    </form:content>
                </form:SimpleForm>
            </Panel>


            <!-- ================= Tech Resource Info ================= -->
            <Panel headerText="Tech Resource Info" expandable="true" expanded="false">
                <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                    <form:content>

                        <Label text="Tech Assessor"/>
                        <Input editable="false" value="{displayTaskModel>/TechAssessor}" width="50%"/>

                        <Label text="Associated Dev Duration (Hrs)"/>
                        <Input editable="false" value="{displayTaskModel>/TechDuration}" width="50%"/>

                        <Label text="Technical Developer"/>
                        <Input editable="false" value="{displayTaskModel>/TechDeveloper}" width="50%"/>

                        <Label text="Technical Complexity"/>
                        <Input editable="false" value="{displayTaskModel>/TechComplexity}" width="50%"/>

                        <Label text="Tech Assessment Start"/>
                        <DatePicker editable="false" dateValue="{displayTaskModel>/TechStartDate}" width="50%"/>

                        <Label text="Technical Design Doc"/>
                        <Input editable="false" value="{displayTaskModel>/TSDURL}" width="50%"/>

                    </form:content>
                </form:SimpleForm>
            </Panel>


            <!-- ================= Requestor Info ================= -->
            <Panel headerText="Requestor Info" expandable="true" expanded="false">
                <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                    <form:content>

                        <Label text="Requestor Email"/>
                        <Input editable="false" value="{displayTaskModel>/RqstrEmail}" width="50%"/>

                        <Label text="Company Site"/>
                        <Input editable="false" value="{displayTaskModel>/Site}" width="50%"/>

                        <Label text="Position / Role"/>
                        <Input editable="false" value="{displayTaskModel>/RqstrPosition}" width="50%"/>

                        <Label text="Region" required="true"/>
                        <Input editable="false" value="{displayTaskModel>/Region}" width="50%"/>

                        <Label text="Contact Number"/>
                        <Input editable="false" value="{displayTaskModel>/MobilePhone}" width="50%"/>

                    </form:content>
                </form:SimpleForm>
            </Panel>


            <!-- ================= Request Details ================= -->
            <Panel headerText="Request Details" expandable="true" expanded="false">
                <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                    <form:content>

                        <Label text="Description of Problem (As-Is)" required="true"/>
                        <TextArea editable="false" value="{displayTaskModel>/AsIs}" width="50%"/>

                        <Label text="Description of To-Be State"/>
                        <TextArea editable="false" value="{displayTaskModel>/ToBe}" width="50%"/>

                        <Label text="BRD SharePoint Link"/>
                        <Input editable="false" value="{displayTaskModel>/BRDSPURL}" width="50%"/>

                        <Label text="Priority to Implement"/>
                        <Input editable="false" value="{displayTaskModel>/PriorityToImpl}" width="50%"/>

                    </form:content>
                </form:SimpleForm>
            </Panel>

        </VBox>

    </content>

</Page>

</mvc:View>